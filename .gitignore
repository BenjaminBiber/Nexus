# Abhängigkeiten
node_modules/

# Build-Ausgaben
dist/
build/
coverage/
*.tsbuildinfo

# Rust: gemeinsames target/ des Cargo-Workspace, ein einzeln gebautes target/ der Desktop-App,
# die bei jedem Tauri-Build neu erzeugten Schemas und das kopierte Sidecar
/target/
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/schemas/
apps/desktop/src-tauri/binaries/

# Test- und Laufzeit-Temp
.tmp-tests/
.vite/
.vitest/
*.log
npm-debug.log*
# Golden-Protokolle der Tests gehören ins Repo
!crates/*/tests/fixtures/*.golden.log

# Umgebungsvariablen und Geheimnisse
.env
.env.*
!.env.example

# Lokale Claude-Code-Einstellungen
.claude/settings.local.json
.claude/worktrees/
.claude/skills/
.agents/

# Anpassungen des Devs (Workflow, Skills, Output-Styles), siehe README „Anpassen“
/custom/

# Spec-Kit-Spezifikationen
/specs/
.specify/
/docs/

# Graphify-Ausgabe
graphify-out/

# Editor und Betriebssystem
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Office-Lock-Dateien
~$*
