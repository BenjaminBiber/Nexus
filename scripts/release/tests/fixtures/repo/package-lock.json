{
  "name": "fixture-repo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "fixture-repo",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "devDependencies": {
        "vitest": "^5.0.3"
      }
    },
    "apps/desktop": {
      "name": "@fix/desktop",
      "version": "0.1.0",
      "devDependencies": {
        "@tauri-apps/cli": "^2"
      }
    },
    "node_modules/@fix/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@fix/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/yaml": {
      "version": "2.5.0",
      "resolved": "https://registry.npmjs.org/yaml/-/yaml-2.5.0.tgz",
      "license": "ISC"
    },
    "packages/cli": {
      "name": "@fix/cli",
      "version": "0.1.0",
      "dependencies": {
        "@fix/core": "0.1.0",
        "@fix/web": "^0.1.0",
        "commander": "^12.1.0"
      }
    },
    "packages/core": {
      "name": "@fix/core",
      "version": "0.1.0",
      "dependencies": {
        "yaml": "^2.5.0"
      }
    },
    "packages/plugin": {
      "name": "@fix/plugin",
      "version": "0.1.0"
    },
    "packages/web": {
      "name": "@fix/web"
    }
  }
}
