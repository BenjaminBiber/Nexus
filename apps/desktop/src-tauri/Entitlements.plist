<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements für Hardened Runtime (macOS). Ohne Hardened Runtime notarisiert Apple nicht.

  allow-jit und allow-unsigned-executable-memory sind entfallen: sie waren nur für das
  Node-Sidecar nötig, dessen V8-Engine Maschinencode zur Laufzeit erzeugte. Seit Phase 5
  liefert die App nur noch den Rust-Server mit.

  Die Netzwerk-Schlüssel wirken nur in der App-Sandbox, die Nexus nicht nutzt. Sie stehen hier,
  weil der Plan „nur Netzwerk“ vorsieht, und schaden ohne Sandbox nicht.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
  </dict>
</plist>
