{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus",
  "identifier": "cc.biber.nexus",
  "build": {
    "frontendDist": "../../../packages/web/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run prepare-binaries",
    "beforeDevCommand": "npm run dev-frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ipc: http://ipc.localhost; img-src 'self' data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline' http://127.0.0.1:*; font-src 'self' data: http://127.0.0.1:*; script-src 'self' http://127.0.0.1:*/themes/"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["nexus"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA1OTc2Mzk2NDRBNjRBNzcKUldSM1NxWkVsbU9YQld0anhkYnJxd2RZT0s2b0hrU2o0elM5UzdXeGtIempJSk95eWJiZVBPZGQK",
      "endpoints": ["https://github.com/BenjaminBiber/Nexus/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb", "rpm"],
    "publisher": "Benjamin Biber",
    "category": "DeveloperTool",
    "shortDescription": "Board, Fragen und Dispatcher für Claude Code",
    "longDescription": "Nexus zeigt Board, Fragen und Dokumente und steuert den Dispatcher für Claude Code.",
    "copyright": "© 2026 Benjamin Biber",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/nexus"],
    "resources": {
      "../../../packages/web/dist/": "web/",
      "../../../crates/nexus-server/assets/toast/": "toast/",
      "../../../packages/plugin/dist/nexus/": "plugin/nexus/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "signingIdentity": null
    },
    "windows": {
      "signCommand": "node scripts/sign-windows.mjs %1",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/installer-header.bmp",
        "sidebarImage": "windows/installer-sidebar.bmp"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "libayatana-appindicator-gtk3"]
      }
    }
  }
}
