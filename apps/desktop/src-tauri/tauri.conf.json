{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus",
  "identifier": "cc.biber.nexus",
  "build": {
    "frontendDist": "../splash",
    "beforeBuildCommand": "npm run prepare-sidecar",
    "beforeDevCommand": "npm run prepare-sidecar"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexus",
        "url": "index.html",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/harness-sidecar"],
    "resources": {
      "../../../dist/sidecar/web/": "web/",
      "../../../dist/sidecar/toast/": "toast/",
      "../../../dist/sidecar/sql/": "sql/"
    }
  }
}
