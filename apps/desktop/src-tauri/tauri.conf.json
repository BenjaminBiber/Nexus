{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus",
  "identifier": "cc.biber.nexus",
  "build": {
    "frontendDist": "../splash",
    "beforeBuildCommand": "npm run prepare-sidecar",
    "beforeDevCommand": "npm run prepare-sidecar"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexus",
        "url": "index.html",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["nexus"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb", "rpm"],
    "publisher": "Benjamin Biber",
    "category": "DeveloperTool",
    "shortDescription": "Board, Fragen und Dispatcher für Claude Code",
    "longDescription": "Nexus zeigt Board, Fragen und Dokumente und steuert den Dispatcher für Claude Code.",
    "copyright": "© 2026 Benjamin Biber",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/nexus", "binaries/harness-sidecar"],
    "resources": {
      "../../../dist/sidecar/web/": "web/",
      "../../../dist/sidecar/toast/": "toast/",
      "../../../dist/sidecar/sql/": "sql/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "signingIdentity": null
    },
    "windows": {
      "signCommand": "node scripts/sign-windows.mjs %1",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "libayatana-appindicator-gtk3"]
      }
    }
  }
}
