# Nach .env kopieren und ausfüllen.
# Passwörter: SQL-Server-Richtlinie (mind. 8 Zeichen, drei von: Groß-, Kleinbuchstaben, Ziffern, Sonderzeichen);
# kein ' und kein $ verwenden.
MSSQL_SA_PASSWORD=
HARNESS_DB_USER=harness
HARNESS_DB_PASSWORD=

# Port auf dem Rechner (1433 und 14330 sind hier schon belegt)
HARNESS_DB_PORT=14333
# 127.0.0.1 = nur dieser Rechner, 0.0.0.0 = auch für andere im Netz
HARNESS_DB_BIND=127.0.0.1

# Ordner mit den SQL-Skripten des Harness (relativ zu dieser Datei)
HARNESS_SQL_DIR=../sql
