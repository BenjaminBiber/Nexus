{
  "title": "Hook session-start: Leitfaden, Kommentar, Umgebungsdatei und Meldung an den Server",
  "fixtures": {
    "repos": [{ "name": "REPO1", "harnessInit": true }],
    "boardConfig": "sqlite",
    "claudeEnvFile": true
  },
  "steps": [
    {
      "name": "Projekt anlegen",
      "method": "POST",
      "path": "/api/db/projects",
      "body": { "key": "ARC", "name": "Arches" },
      "record": false
    },
    {
      "name": "Board anlegen",
      "method": "POST",
      "path": "/api/db/boards",
      "body": { "project": "ARC", "name": "Sprint" },
      "record": false
    },
    {
      "name": "Board dem Repo zuordnen",
      "method": "PATCH",
      "path": "/api/db/boards/1",
      "body": { "repoPath": "{{REPO1}}" },
      "record": false
    },
    {
      "name": "Ticket in Arbeit anlegen",
      "method": "POST",
      "path": "/api/db/boards/1/tickets",
      "body": { "title": "Login bauen", "status": "in_progress" },
      "record": false
    },
    {
      "name": "Kommentar anhängen",
      "method": "POST",
      "path": "/api/db/tickets/ARC-0001/comments",
      "body": { "body": "Bitte Tastatur beachten" },
      "record": false
    },
    {
      "name": "Projekt am Server anmelden",
      "method": "POST",
      "path": "/api/projects",
      "body": { "path": "{{REPO1}}" },
      "save": { "pid": "json.id" },
      "record": false
    },
    {
      "name": "session-start",
      "kind": "cli",
      "args": ["hook", "session-start"],
      "cwd": "{{REPO1}}",
      "stdin": { "session_id": "s1", "cwd": "{{REPO1}}", "source": "startup" },
      "env": { "HARNESS_TICKET": "ARC-0001", "HARNESS_HOOK_DEADLINE_MS": "60000" }
    },
    { "name": "Sessions am Server", "method": "GET", "path": "/api/projects/{{pid}}/sessions" },
    {
      "name": "session-start erneut: Kommentar gilt als gelesen",
      "kind": "cli",
      "args": ["hook", "session-start"],
      "cwd": "{{REPO1}}",
      "stdin": { "session_id": "s1", "cwd": "{{REPO1}}", "source": "resume" },
      "env": { "HARNESS_TICKET": "ARC-0001", "HARNESS_HOOK_DEADLINE_MS": "60000" }
    }
  ]
}
