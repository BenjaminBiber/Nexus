[
  {
    "name": "Projekt anmelden",
    "request": {
      "body": {
        "path": "<REPO1>"
      },
      "method": "POST",
      "path": "/api/projects"
    },
    "response": {
      "status": 201
    }
  },
  {
    "name": "Einstellungen des Projekts",
    "request": {
      "method": "GET",
      "path": "/api/projects/<var:pid>/settings"
    },
    "response": {
      "contentType": "application/json",
      "json": {
        "project": {
          "id": "<var:pid>",
          "name": "Mein Projekt ä",
          "path": "<REPO1>"
        },
        "token": "<var:token>"
      },
      "status": 200
    }
  },
  {
    "name": "Einstellungen eines unbekannten Projekts",
    "request": {
