  "steps": [
    { "name": "Vorschläge ohne Einstellung und ohne Läufe", "method": "GET", "path": "/api/dispatch/suggestions" },

    {
      "name": "Projekt anlegen",
      "method": "POST",
      "path": "/api/db/projects",
      "body": { "key": "ARC", "name": "Arches" },
      "compare": "status"
    },
    {
      "name": "zweites Projekt anlegen",
      "method": "POST",
      "path": "/api/db/projects",
      "body": { "key": "OTH", "name": "Andere" },
      "compare": "status"
    },
    {
      "name": "Board anlegen",
      "method": "POST",
      "path": "/api/db/boards",
      "body": { "project": "ARC", "name": "Sprint" },
      "compare": "status"
    },
    {
      "name": "Einstellung mit Leiter, Regel und ungenutztem Profil speichern",
      "method": "PUT",
      "path": "/api/dispatch/config",
      "body": {
        "enabled": true,
        "wip": 1,
        "optInLabel": "auto",
        "maxAttempts": 3,
        "profiles": {
          "klein": { "model": "sonnet", "effort": "high", "maxTurns": 20, "timeoutMinutes": 30 },
          "standard": { "model": "opus", "effort": "high", "maxTurns": 40, "timeoutMinutes": 60 },
          "gross": { "model": "opus", "effort": "max", "maxTurns": 80, "timeoutMinutes": 120 },
          "alt": { "model": "sonnet", "effort": "high", "maxTurns": 10, "timeoutMinutes": 15 }
        },
        "defaultProfile": "standard",
        "escalation": ["standard", "gross"],
        "rules": [{ "when": { "labels": ["klein"] }, "profile": "klein" }],
        "research": { "auto": false, "wip": 1, "maxPerDay": 10 },
        "planning": { "auto": false, "wip": 1 }
      },
      "compare": "status"
    },
    {
      "name": "vorgemerkte Läufe mit einem Durchlauf in die Auswertung schreiben",
      "method": "POST",
      "path": "/api/dispatch/run",
      "body": {},
      "compare": "status"
    },

    {
      "name": "Vorschläge aus den Läufen lesen",
      "method": "GET",
      "path": "/api/dispatch/suggestions",
      "save": { "hash": "json.configHash", "umlenken": "json.suggestions.0.id", "schritte": "json.suggestions.1.id", "hinweis": "json.suggestions.4.id" }
    },
    { "name": "Vorschlag ausblenden", "method": "POST", "path": "/api/dispatch/suggestions/{{schritte}}/dismiss", "body": {} },
    { "name": "Vorschlag wieder einblenden", "method": "DELETE", "path": "/api/dispatch/suggestions/{{schritte}}/dismiss", "body": {} },
    { "name": "Vorschlag mit kaputter ID ausblenden", "method": "POST", "path": "/api/dispatch/suggestions/kaputt!/dismiss", "body": {} },

    { "name": "Analyse von Claude starten (Vertragsmodus antwortet mit leerer Liste)", "method": "POST", "path": "/api/dispatch/suggestions/analyze", "body": {} },

    {
      "name": "Übernehmen mit veralteter Einstellung",
      "method": "POST",
      "path": "/api/dispatch/suggestions/{{umlenken}}/apply",
      "body": { "configHash": "veraltet" }
    },
    {
      "name": "Übernehmen ohne Hash der Einstellung",
      "method": "POST",
      "path": "/api/dispatch/suggestions/{{umlenken}}/apply",
      "body": {}
    },
    {
      "name": "unbekannten Vorschlag übernehmen",
      "method": "POST",
      "path": "/api/dispatch/suggestions/0000000000000000/apply",
      "body": { "configHash": "{{hash}}" }
    },
    {
      "name": "Vorschlag mit kaputter ID übernehmen",
      "method": "POST",
      "path": "/api/dispatch/suggestions/kaputt!/apply",
      "body": { "configHash": "{{hash}}" }
    },
    {
      "name": "Hinweis ohne Änderung übernehmen",
      "method": "POST",
      "path": "/api/dispatch/suggestions/{{hinweis}}/apply",
      "body": { "configHash": "{{hash}}" }
    },
    {
      "name": "Vorschlag übernehmen (Vorlagen der Prompts stehen im Vertrag der Einstellung)",
      "method": "POST",
      "path": "/api/dispatch/suggestions/{{umlenken}}/apply",
      "body": { "configHash": "{{hash}}" },
      "ignore": ["json.view.promptInfo"]
    }
  ]
}
