  {
    "name": "Einstellung mit Leiter, Regel und ungenutztem Profil speichern",
    "request": {
      "body": {
        "defaultProfile": "standard",
        "enabled": true,
        "escalation": [
          "standard",
          "gross"
        ],
        "maxAttempts": 3,
        "optInLabel": "auto",
        "planning": {
          "auto": false,
          "wip": 1
        },
        "profiles": {
          "alt": {
            "effort": "high",
            "maxTurns": 10,
            "model": "sonnet",
            "timeoutMinutes": 15
          },
          "gross": {
            "effort": "max",
            "maxTurns": 80,
            "model": "opus",
            "timeoutMinutes": 120
          },
          "klein": {
            "effort": "high",
            "maxTurns": 20,
            "model": "sonnet",
            "timeoutMinutes": 30
          },
          "standard": {
            "effort": "high",
            "maxTurns": 40,
            "model": "opus",
            "timeoutMinutes": 60
          }
        },
        "research": {
          "auto": false,
          "maxPerDay": 10,
          "wip": 1
        },
        "rules": [
          {
            "profile": "klein",
            "when": {
              "labels": [
                "klein"
              ]
            }
          }
        ],
        "wip": 1
      },
      "method": "PUT",
      "path": "/api/dispatch/config"
    },
    "response": {
      "status": 200
    }
  },
