[
  {
    "name": "Stand ohne eingeschalteten Bot",
    "request": {
      "method": "GET",
      "path": "/api/telegram/status"
    },
    "response": {
      "contentType": "application/json",
      "json": {
        "bot": {
          "botId": null,
          "botName": null,
          "lastError": null,
          "lastUpdateAt": null,
          "profileError": null,
          "state": "off"
        },
        "openCodes": 0,
        "pairedChats": 1
      },
      "status": 200
    }
  },
  {
    "name": "Attrappe der Bot-API starten",
    "request": {
      "action": "start",
      "body": {
        "ok": true,
        "result": true
      },
      "routes": [
        "getMe",
        "getUpdates"
      ],
      "status": 200,
      "stub": "TELEGRAM"
    },
    "response": {
      "json": {
        "url": "<var:tgUrl>"
      }
    }
  },
  {
    "name": "Bot auf die Attrappe einschalten",
    "request": {
      "body": {
        "apiBase": "<var:tgUrl>",
        "enabled": true
      },
      "method": "PUT",
      "path": "/api/telegram/config"
    },
    "response": {
      "contentType": "application/json",
      "json": {
        "apiBase": "<var:tgUrl>",
        "botToken": "123456:…Dsaw",
        "chats": [
          4242
        ],
        "enabled": true,
        "ideas": {
          "defaultTarget": "note",
          "maxRounds": 5
        },
        "notify": {
          "blocked": true,
          "merge": true,
          "merged": false,
          "paused": false,
          "question": true,
          "review": true
        },
        "profile": {
          "applied": null
        },
        "quietHours": null,
        "speech": {
          "apiKey": "",
          "backend": "openai-compatible",
          "baseUrl": "https://api.openai.com",
          "language": "de",
          "model": "gpt-4o-mini-transcribe",
          "whisperCli": {
            "binary": "whisper-cli",
            "ffmpeg": "ffmpeg",
            "model": ""
          }
        }
      },
      "status": 200
    }
  },
  {
    "name": "warten, bis der Bot sich angemeldet hat",
    "request": {
      "action": "await",
      "call": "setMyCommands",
      "count": 1,
      "stub": "TELEGRAM"
    },
    "response": {
      "json": {
        "ok": true
      }
    }
  },
  {
    "name": "Stand des laufenden Bots",
    "request": {
      "method": "GET",
      "path": "/api/telegram/status"
    },
    "response": {
      "contentType": "application/json",
      "json": {
