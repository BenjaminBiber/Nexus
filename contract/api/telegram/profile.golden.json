      "status": 200,
      "stub": "TELEGRAM"
    },
    "response": {
      "json": {
        "url": "<var:tgUrl>"
      }
    }
  },
  {
    "name": "Bot auf die Attrappe einschalten",
    "request": {
      "body": {
        "apiBase": "<var:tgUrl>",
        "enabled": true
      },
      "method": "PUT",
      "path": "/api/telegram/config"
    },
    "response": {
      "contentType": "application/json",
      "json": {
        "apiBase": "<var:tgUrl>",
