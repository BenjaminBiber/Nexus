        "sent": 1
      },
      "status": 200
    }
  },
  {
    "name": "die geschickten Nachrichten an der Attrappe",
    "request": {
      "action": "await",
      "call": "sendMessage",
      "count": 2,
      "stub": "TELEGRAM"
    },
    "response": {
      "json": {
        "ok": true
      }
    }
  },
  {
