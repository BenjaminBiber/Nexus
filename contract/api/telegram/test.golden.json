      "path": "/api/telegram/test"
    },
    "response": {
      "contentType": "application/json",
      "json": {
        "errors": [
          {
            "chatId": 77,
            "error": "Telegram antwortete mit Fehler 403: Forbidden: bot was blocked by the user"
