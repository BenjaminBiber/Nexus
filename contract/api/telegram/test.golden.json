[
  {
    "name": "Testnachricht ohne eingeschalteten Bot",
    "request": {
      "body": {},
      "method": "POST",
      "path": "/api/telegram/test"
    },
    "response": {
      "contentType": "application/json",
      "json": {
        "code": "telegram-not-running",
        "message": "Der Bot läuft nicht – erst einschalten und ein Bot-Token eintragen."
      },
      "status": 409
    }
  },
  {
    "name": "Attrappe der Bot-API starten",
    "request": {
      "action": "start",
      "body": {
        "ok": true,
        "result": true
      },
      "routes": [
        "getMe",
        "getUpdates",
        "sendMessage"
      ],
      "status": 200,
      "stub": "TELEGRAM"
    },
    "response": {
      "json": {
        "url": "<var:tgUrl>"
      }
    }
  },
  {
    "name": "Bot auf die Attrappe einschalten",
    "request": {
      "body": {
        "apiBase": "<var:tgUrl>",
        "enabled": true
      },
      "method": "PUT",
      "path": "/api/telegram/config"
    },
    "response": {
      "contentType": "application/json",
      "json": {
        "apiBase": "<var:tgUrl>",
        "botToken": "123456:…Dsaw",
        "chats": [
          4242,
          77
        ],
        "enabled": true,
        "ideas": {
          "defaultTarget": "note",
          "maxRounds": 5
        },
        "notify": {
          "blocked": true,
          "merge": true,
          "merged": false,
          "paused": false,
          "question": true,
          "review": true
        },
        "profile": {
          "applied": null,
          "brand": true
        },
        "quietHours": null,
        "speech": {
          "apiKey": "",
          "backend": "openai-compatible",
          "baseUrl": "https://api.openai.com",
          "language": "de",
          "model": "gpt-4o-mini-transcribe",
          "whisperCli": {
            "binary": "whisper-cli",
            "ffmpeg": "ffmpeg",
            "model": ""
          }
        }
      },
      "status": 200
    }
  },
  {
    "name": "warten, bis der Bot sich angemeldet hat",
    "request": {
      "action": "await",
      "call": "setMyCommands",
      "count": 1,
      "stub": "TELEGRAM"
    },
    "response": {
      "json": {
        "ok": true
      }
    }
  },
  {
    "name": "Testnachricht an beide Chats",
    "request": {
      "body": {},
