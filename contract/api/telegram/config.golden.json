  {
    "name": "Bot-Token ohne Muster",
    "request": {
      "body": {
        "botToken": "kaputt:kurz"
      },
      "method": "PUT",
      "path": "/api/telegram/config"
    },
    "response": {
      "contentType": "application/json",
      "json": {
        "code": "telegram-config-invalid",
        "message": "botToken sieht nicht wie ein Bot-Token von @BotFather aus (Zahl, Doppelpunkt, Geheimnis)."
      },
      "status": 400
    }
  },
  {
    "name": "Nachtruhe ohne Uhrzeit",
    "request": {
      "body": {
        "quietHours": {
          "from": "22:00",
          "to": "7 Uhr"
        }
      },
      "method": "PUT",
      "path": "/api/telegram/config"
    },
    "response": {
      "contentType": "application/json",
      "json": {
        "code": "telegram-config-invalid",
        "message": "quietHours braucht from und to im Format HH:MM, z. B. from: \"22:00\", to: \"07:00\"."
      },
      "status": 400
    }
  },
  {
    "name": "Runden außerhalb von eins bis zehn",
    "request": {
      "body": {
        "ideas": {
          "maxRounds": 99
        }
      },
      "method": "PUT",
      "path": "/api/telegram/config"
    },
    "response": {
      "contentType": "application/json",
      "json": {
        "code": "telegram-config-invalid",
        "message": "ideas.maxRounds muss eine ganze Zahl von 1 bis 10 sein."
      },
      "status": 400
    }
  },
  {
    "name": "Adresse ohne http",
    "request": {
      "body": {
        "apiBase": "ftp://telegram.invalid"
      },
      "method": "PUT",
      "path": "/api/telegram/config"
    },
    "response": {
      "contentType": "application/json",
      "json": {
        "code": "telegram-config-invalid",
        "message": "apiBase muss eine Adresse mit http:// oder https:// sein."
      },
      "status": 400
    }
  },
