{
  "title": "Review vor dem Merge: Dateiliste des Ticket-Branches, Patch einer Datei und Fehlerfälle",
  "fixtures": {
    "repos": [
      {
        "name": "REPO1",
        "files": {
          "README.md": "# Bestellung\n",
          "src/preis.ts": "export function preis(netto: number): number {\n  return netto;\n}\n",
          "src/alt.ts": "export const ALT = true;\n",
          "docs/notiz.md": "Die Preise stehen in src/preis.ts.\n"
        }
      }
    ],
    "boardConfig": "sqlite"
  },
  "steps": [
    { "name": "Projekt", "method": "POST", "path": "/api/db/projects", "body": { "key": "BEN", "name": "Bestellung" }, "record": false },
    { "name": "Board", "method": "POST", "path": "/api/db/boards", "body": { "project": "BEN", "name": "Sprint" }, "record": false },
    { "name": "Repo-Pfad des Boards", "method": "PATCH", "path": "/api/db/boards/1", "body": { "repoPath": "{{REPO1}}" }, "record": false },
    { "name": "Board aktivieren", "method": "POST", "path": "/api/db/boards/1/activate", "body": {}, "record": false },
    {
      "name": "Ticket für den Dispatcher",
      "method": "POST",
      "path": "/api/db/boards/1/tickets",
      "body": { "title": "Rabatt einbauen", "acceptance": "Der Preis sinkt um den Rabatt.", "labels": ["auto"], "needsPlanning": false },
      "record": false
    },
    {
      "name": "Plan und Handbuch",
      "method": "PATCH",
      "path": "/api/db/tickets/BEN-0001",
      "body": { "rev": 1, "plan": "Rabatt in preis() verrechnen.", "handbook": "Tests mit vitest." },
      "record": false
    },
    { "name": "Ticket nach Geplant", "method": "POST", "path": "/api/db/tickets/BEN-0001/move", "body": { "status": "planned" }, "record": false },
    {
      "name": "zweites Ticket ohne Label „auto“ – es wird nie gestartet und hat deshalb keinen Branch",
      "method": "POST",
      "path": "/api/db/boards/1/tickets",
      "body": { "title": "Versand prüfen", "acceptance": "Die Versandkosten stimmen." },
      "record": false
    },
    { "name": "Dispatcher einschalten", "method": "POST", "path": "/api/dispatch/enable", "body": {}, "record": false },
    {
      "name": "Durchlauf: der Dispatcher legt Branch und Worktree des Tickets an",
      "method": "POST",
      "path": "/api/dispatch/run",
      "body": {},
      "save": { "lauf": "json.runs.0.id" },
      "record": false
    },
    {
      "name": "Arbeit des Agenten im Worktree: Datei geändert, neue Datei, gelöschte Datei, umbenannte Datei",
      "kind": "commit",
      "cwd": "{{REPO1}}-worktrees/BEN-0001",
      "files": {
        "src/preis.ts": "export function preis(netto: number): number {\n  return netto * (1 - RABATT);\n}\n",
        "src/rabatt.ts": "export const RABATT = 0.1;\n",
        "docs/hinweis.md": "Die Preise stehen in src/preis.ts.\n"
      },
      "remove": ["src/alt.ts", "docs/notiz.md"],
      "message": "BEN-0001: Rabatt eingebaut",
      "record": false
    },
    {
      "name": "der Agent hakt das Ticket ab",
      "method": "POST",
      "path": "/api/db/tickets/BEN-0001/move",
      "body": { "status": "done", "acceptance": "Der Preis sinkt um den Rabatt." },
      "record": false
    },
    {
      "name": "Ergebnis des Workers: zwei Testläufe, einer rot",
      "kind": "homeFile",
      "path": "dispatch/runs/{{lauf}}.result.json",
      "content": {
        "code": 0,
        "timedOut": false,
        "endedAt": "2020-03-02T08:45:00.000Z",
        "output": "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01\",\"name\":\"Bash\",\"input\":{\"command\":\"npx vitest run\"}}]}}\n{\"type\":\"user\",\"message\":{\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_01\",\"content\":\"Test Files  2 passed (2)\\nTests  7 passed (7)\"}]}}\n{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_02\",\"name\":\"Bash\",\"input\":{\"command\":\"npm run lint\"}}]}}\n{\"type\":\"user\",\"message\":{\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_02\",\"is_error\":true,\"content\":\"1 problem (1 error, 0 warnings)\"}]}}\n{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"Rabatt eingebaut.\",\"total_cost_usd\":0}\n"
      },
      "record": false
    },
    {
      "name": "Durchlauf: der Dispatcher wertet den Lauf aus und hält das Ticket zur Freigabe an",
      "method": "POST",
      "path": "/api/dispatch/run",
      "body": {},
      "record": false
    },

    { "name": "Review des Tickets", "method": "GET", "path": "/api/dispatch/review/BEN-0001" },
    { "name": "Review mit klein geschriebener Ticket-ID", "method": "GET", "path": "/api/dispatch/review/ben-0001" },
    { "name": "Patch einer geänderten Datei", "method": "GET", "path": "/api/dispatch/review/BEN-0001/file?path=src/preis.ts" },
    { "name": "Patch einer neuen Datei", "method": "GET", "path": "/api/dispatch/review/BEN-0001/file?path=src/rabatt.ts" },
    { "name": "Patch einer gelöschten Datei", "method": "GET", "path": "/api/dispatch/review/BEN-0001/file?path=src/alt.ts" },
    { "name": "Patch einer umbenannten Datei", "method": "GET", "path": "/api/dispatch/review/BEN-0001/file?path=docs/hinweis.md" },
    { "name": "Patch einer Datei außerhalb der Liste", "method": "GET", "path": "/api/dispatch/review/BEN-0001/file?path=README.md" },
    { "name": "Patch ohne Datei", "method": "GET", "path": "/api/dispatch/review/BEN-0001/file" },
    { "name": "Patch mit leerem Pfad", "method": "GET", "path": "/api/dispatch/review/BEN-0001/file?path=" },
    { "name": "Review eines Tickets ohne Branch", "method": "GET", "path": "/api/dispatch/review/BEN-0002" },
    { "name": "Patch zu einem Ticket ohne Branch", "method": "GET", "path": "/api/dispatch/review/BEN-0002/file?path=src/preis.ts" },
    { "name": "Review eines unbekannten Tickets", "method": "GET", "path": "/api/dispatch/review/BEN-0099" },
    { "name": "Patch zu einem unbekannten Ticket", "method": "GET", "path": "/api/dispatch/review/BEN-0099/file?path=src/preis.ts" },

    { "name": "Repo-Pfad des Boards entfernen", "method": "PATCH", "path": "/api/db/boards/1", "body": { "repoPath": null }, "record": false },
    { "name": "Review ohne Repo-Pfad am Board", "method": "GET", "path": "/api/dispatch/review/BEN-0001" },
    { "name": "Patch ohne Repo-Pfad am Board", "method": "GET", "path": "/api/dispatch/review/BEN-0001/file?path=src/preis.ts" }
  ]
}
