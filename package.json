{
  "name": "ai-harness",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run build -w packages/web",
    "typecheck": "tsc --noEmit -p packages/web && tsc --noEmit -p packages/theme-sdk",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "dev": "node scripts/dev.mjs",
    "desktop": "npm run tauri -w apps/desktop --",
    "dev:web": "npm run dev -w packages/web",
    "build:plugin": "node packages/plugin/scripts/build-plugin.mjs",
    "contract": "node contract/run.mjs",
    "test:unit": "vitest run"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "yaml": "^2.5.0"
  }
}
