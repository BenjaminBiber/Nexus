{
  "name": "ai-harness",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/db packages/server packages/cli && tsc --noEmit -p packages/web && npm run build -w packages/web",
    "typecheck": "tsc -b packages/core packages/db packages/server packages/cli && tsc --noEmit -p packages/web",
    "lint": "npm run typecheck",
    "test": "vitest run && vitest run -c vitest.process.config.ts",
    "test:concurrency": "vitest run -c vitest.concurrency.config.ts",
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w packages/web",
    "dev:server": "tsx packages/server/src/main.ts",
    "build:plugin": "node packages/plugin/scripts/build-plugin.mjs",
    "build:sidecar": "node scripts/sidecar/build-sidecar.mjs",
    "setup": "node scripts/setup.mjs",
    "customize": "node scripts/customize.mjs",
    "contract": "node contract/run.mjs",
    "test:unit": "vitest run",
    "test:process": "vitest run -c vitest.process.config.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
